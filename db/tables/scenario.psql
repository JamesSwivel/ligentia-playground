CREATE TABLE IF NOT EXISTS scenario (
  id int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  
  -- Scenario id: 1,1p2,2,2p2,3,4
  scenario_id     varchar(50) NOT NULL,
  shipment_num    varchar(20) NOT NULL,
  booking_num     varchar(20) NOT NULL,
  
  -- client is consignee
  client_id       int NOT NULL,
  client_name     varchar(100) NOT NULL,

  -- vendor is supplier
  vendor_id       int NOT NULL,
  vendor_name     varchar(100) NOT NULL,

  -- mot: Sea/Air
  mot             varchar(10) NOT NULL,

  -- delivery mode, e.g. FCL, LCL
  delivery_mode   varchar(10) NOT NULL,

  currencies_json                  JSON NOT NULL,
  shipment_booking_search          JSON NOT NULL,
  shipment_details                 JSON NOT NULL,
  shipment_search                  JSON NOT NULL,
  shipment_summary                 JSON NOT NULL,

  -- screen data
  screen_js                        JSON NOT NULL,

  -- URL
  booking_url                      TEXT NOT NULL
);

