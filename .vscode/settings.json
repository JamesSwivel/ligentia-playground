  // jump to open file if already opened
  "workbench.editor.revealIfOpen": true,
  // python file uses black formatter
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  //   "python.formatting.blackArgs": ["--line-length", "120"],
  // black formatter args
  "black-formatter.args": ["--line-length", "120"],
  // Python/Pylance or linter configurations
  // pylance: specify python version under a virtualenv
  // "python.defaultInterpreterPath": ".\\winEnv\\Scripts\\python.exe",
  "python.defaultInterpreterPath": "${env:HOME}/.pyenv/versions/ligentia-playground/bin/python3",
  "python.analysis.typeCheckingMode": "basic",
  // pylance: extra paths for import resolution
  "python.analysis.extraPaths": ["./src/lib", "./srcTest", "./scripts"],
  // plyance: exclude paths
  "python.analysis.exclude": [
    "./out",
    "./temp",
    "./cfg",
    "./data",
    "./db",
    "./docker",
    "./httpRequest",
    "./log",
    "./nginx",
    // Avoid strange warnings because of packages installed on virtualenv
    "./winEnv",
    "**/node_modules",
    "**/__pycache__",
    "**/.*", ".venv"
  ],
  "python.experiments.optOutFrom": ["pythonTerminalEnvVarActivation"],
  // "python.autoComplete.extraPaths": [
  //   "/usr/local/lib/python3.8/dist-packages/cv2/python-3.8"
  // ],
  // auto format
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "scm.showHistoryGraph": false,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shellIntegration.enabled": false,
  // Enable auto formmat for Jupyter notebook
  "notebook.defaultFormatter": "ms-python.black-formatter",
  "notebook.formatOnCellExecution": true,
  "notebook.formatOnSave.enabled": true,
  // "search.useIgnoreFiles": false,
  // If you prefer to use the full power of searching, selecting, or manipulating in Visual Studio Code, you can preview the response in an untitled document
  // "rest-client.previewResponseInUntitledDocument":true,
  // These seems not working
  "rest-client.excludeHostsForProxy": [
    // "0.0.0.0",
    // "127.0.0.1",
    // "xdata-localhost.ddns.net",
    // "xdata-staging.ddns.net"
  ],
  "indentRainbow.includedLanguages": [],
  "python-envs.defaultEnvManager": "ms-python.python:pyenv"
}
