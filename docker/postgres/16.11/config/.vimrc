:set background=dark
:set tabstop=4
:set softtabstop=4
":set noexpandtab           " makefile needs real TAB
:set expandtab
:set shiftwidth=4
:set autoindent
:set ruler
:set showmode
:set nu
:set statusline+=%F         " show full path file being edited (%f shows only filename)
:set laststatus=2           " enable bottom statusbar
:syntax on                  " turn on syntax highlight
